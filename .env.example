# ==========================================
# FMKAL VEHICLE CONTACT SYSTEM - ENVIRONMENT
# ==========================================

# Environment mode
NODE_ENV=production

# Server listening port
PORT=3000

# SQLite persistent database URL
# In Docker: file:/app/data/prod.db
# In Local Dev: file:./dev.db
DATABASE_URL="file:./dev.db"

# JWT Secret for signing secure admin session tokens
# Generate with: openssl rand -base64 32
JWT_SECRET="fmkal-prod-secret-change-this-random-key-2026"

# Initial Admin Credentials (used during database seed)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin1234!"
