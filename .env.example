# ==========================================
# FMKAL VEHICLE CONTACT SYSTEM - ENVIRONMENT
# ==========================================

# Environment mode
NODE_ENV=production

# Server listening port
PORT=1234

# SQLite persistent database URL
# In Docker: file:/app/data/prod.db
# In Local Dev: file:./dev.db
DATABASE_URL="file:./dev.db"

# JWT Secret for signing secure admin session tokens
# IMPORTANT: Generate a random 64-character string in production!
# e.g.: openssl rand -hex 32
JWT_SECRET=""

# Initial Admin Credentials (used during first database seed)
# Choose a strong password with letters, numbers, and symbols
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""
